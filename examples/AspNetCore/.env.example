# Copy to ".env" and load it before running (see README.md).
#
# From your FastPix Dashboard (https://dashboard.fastpix.com):
#   Access Token -> FASTPIX_USERNAME
#   Secret Key   -> FASTPIX_PASSWORD
FASTPIX_USERNAME=
FASTPIX_PASSWORD=

# From Dashboard > Webhooks — used to verify incoming webhook signatures.
FASTPIX_WEBHOOK_SECRET=
